DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ytresearch?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/ytresearch?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
# Do not add a NEXT_PUBLIC Supabase service-role key. Service-role credentials, if ever needed,
# must stay server-only and must never be imported by browser/client components.
YOUTUBE_DATA_API_KEY="your-youtube-data-api-key"
YOUTUBE_DAILY_QUOTA_LIMIT="9000"
YTRESEARCH_DAILY_AI_SPEND_ALERT_USD="25"
YTRESEARCH_JOBS_SECRET="replace-with-a-long-random-cron-secret"

# App-level transactional email through Resend
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="YTResearch <reports@your-domain.com>"
# Optional fallback if RESEND_FROM_EMAIL is not set
EMAIL_FROM="YTResearch <reports@your-domain.com>"

# Cloudflare R2 object storage. Keep credentials server-only.
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_BUCKET_NAME="ytresearch"
CLOUDFLARE_R2_REGION="auto"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Optional custom domain or public CDN base URL for persisted asset URLs.
CLOUDFLARE_R2_PUBLIC_BASE_URL="https://assets.your-domain.com"

# Vercel AI SDK direct provider keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
XAI_API_KEY="your-xai-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
GROQ_API_KEY="your-groq-api-key"
FAL_API_KEY="your-fal-api-key"
PIAPI_API_KEY="your-piapi-api-key"
